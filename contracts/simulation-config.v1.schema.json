{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echospace.local/contracts/simulation-config.v1.schema.json",
  "title": "EchoSpace software-in-the-loop simulation configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "echospace.simulation_config.v1"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "virtual",
            "replay"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sample_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "room": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "enum": [
                "rectangle",
                "l_room"
              ]
            },
            "width_m": {
              "type": "number",
              "minimum": 3,
              "maximum": 10
            },
            "depth_m": {
              "type": "number",
              "minimum": 3,
              "maximum": 10
            },
            "height_m": {
              "type": "number",
              "minimum": 2,
              "maximum": 5
            },
            "reflection": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.98
            }
          }
        },
        "scanner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position_m": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -30,
                "maximum": 30
              }
            },
            "heading_deg": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "fov_deg": {
              "type": "number",
              "minimum": 10,
              "maximum": 360
            },
            "rays": {
              "type": "integer",
              "minimum": 16,
              "maximum": 1441
            },
            "range_m": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 20
            },
            "range_std_m": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "dropout": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.8
            }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "excitation": {
              "enum": [
                "impulse",
                "sweep"
              ]
            },
            "speed_m_s": {
              "type": "number",
              "minimum": 300,
              "maximum": 370
            },
            "noise_snr_db": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "gain_db": {
              "type": "number",
              "minimum": -12,
              "maximum": 12
            },
            "lowpass_hz": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 500,
                  "maximum": 7900
                },
                {
                  "type": "null"
                }
              ]
            },
            "offset_ms": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "clock_drift_ppm": {
              "type": "number",
              "minimum": -500,
              "maximum": 500
            },
            "adc_bits": {
              "type": "integer",
              "minimum": 8,
              "maximum": 24
            },
            "clip_level": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 2
            },
            "pose_noise_m": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.1
            }
          }
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 30
                }
              },
              "receiver_m": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 30
                }
              }
            },
            "required": [
              "source_m",
              "receiver_m"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "replay"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "sample_id"
            ],
            "properties": {
              "sample_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "config"
  ]
}
